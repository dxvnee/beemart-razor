<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BeeMart</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var fullName = Context.Session.GetString("fullName");
    var role = Context.Session.GetString("role");
    var toast = TempData["Toast"] as string;
}
<header class="topbar">
    <a class="brand" asp-page="/Index">BeeMart</a>
    @if (!string.IsNullOrEmpty(fullName))
    {
        <nav class="nav">
            <a asp-page="/NewTransaction">New Transaction</a>
            <a asp-page="/History">History Transaction</a>
        </nav>
        <div class="user">
            <span>@fullName (@role)</span>
            <form method="post" asp-page="/Logout">
                <button type="submit" class="btn btn-ghost">Logout</button>
            </form>
        </div>
    }
</header>

<main class="container">
    @RenderBody()
</main>

<div id="toast-container"></div>
@if (!string.IsNullOrEmpty(toast))
{
    <div id="toast-data" data-toast="@toast" hidden></div>
}

<script src="~/js/toast.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>