@page
@model NewTransaction
@{
    ViewData["Title"] = "New Transaction";
}
@Html.AntiForgeryToken()

<h1>New Transaction</h1>

<section class="card tx-header">
    <div>
        <span class="label">Invoice Number</span>
        <input id="invoice" type="text" value="Memuat..." readonly tabindex="-1" />
    </div>
    <div>
        <span class="label">Kasir</span>
        <strong>@HttpContext.Session.GetString("fullName")</strong>
    </div>
    <div>
        <span class="label">Tanggal &amp; Jam</span>
        <strong id="clock">-</strong>
    </div>
</section>

<div class="tx-layout">
    <section class="card">
        <h2>Cari Barang</h2>
        <div class="field">
            <input id="search" type="search" placeholder="Ketik nama barang..." autocomplete="off" />
        </div>
        <table class="table">
            <thead>
                <tr><th>Barang</th><th>Harga</th><th>Qty</th><th></th></tr>
            </thead>
            <tbody id="search-results"></tbody>
        </table>
    </section>

    <section class="card">
        <h2>Keranjang</h2>
        <table class="table">
            <thead>
                <tr><th>Barang</th><th>Harga</th><th>Qty</th><th>Subtotal</th><th></th></tr>
            </thead>
            <tbody id="cart-body"></tbody>
        </table>

        <div class="total-row">
            <span>Total</span>
            <strong id="total">Rp 0</strong>
        </div>

        <div class="field">
            <label for="payment">Metode Pembayaran</label>
            <select id="payment" required>
                <option value="">-- Memuat metode... --</option>
            </select>
        </div>
        <button id="btn-save" type="button" class="btn btn-primary btn-block">Simpan Transaksi</button>
    </section>
</div>

@section Scripts {
    <script src="~/js/new-transaction.js" asp-append-version="true"></script>
}