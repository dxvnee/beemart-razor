# ========================================================
# BeeMart POS System - Environment Variables Template
# ========================================================

# Database Configuration (SQL Server)
DB_CONNECTION=Server=localhost,1433;Database=BeeMartDb;User Id=sa;Password=YourPasswordHere;TrustServerCertificate=True;

# JWT Authentication
JWT_KEY=YourSuperSecretKeyWithMinimum32CharactersLengthHere!
JWT_ISSUER=BeeMart.Api
JWT_AUDIENCE=BeeMart.WebClient
JWT_EXPIRE_MINUTES=120

# Timezone Configuration (WIB)
TIMEZONE_ID=Asia/Jakarta

# Frontend WebClient - Backend API Base URL
API_BASE_URL=http://localhost:5100/api/v1/
