<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BeeMart</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var fullName = Context.Session.GetString("fullName");
    var role = Context.Session.GetString("role");
    var toast = TempData["Toast"] as string;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isNewTx = currentPage == "/NewTransaction";
}

@if (!string.IsNullOrEmpty(fullName))
{
    <header class="topbar">
        <a class="brand" asp-page="/NewTransaction">BeeMart</a>
        <div class="user">
            @if (isNewTx)
            {
                <span class="user-info"><span id="header-clock"></span> | Kasir: @fullName</span>
            }
            else
            {
                <span class="user-info">Role: <span class="role-badge">@(role == "Kasir" ? "Cashier" : role)</span> | Login: @fullName</span>
            }
            <form method="post" asp-page="/Logout">
                <button type="submit" class="btn btn-logout">Logout</button>
            </form>
        </div>
    </header>

    <main class="container">
        <div class="app-card">
            <div class="tab-nav-wrapper">
                <nav class="tab-nav">
                    <a asp-page="/NewTransaction" class="@(isNewTx ? "active" : "")">New Transaction</a>
                    <a asp-page="/History" class="@(currentPage == "/History" ? "active" : "")">History Transaction</a>
                </nav>
            </div>
            @RenderBody()
        </div>
    </main>
}
else
{
    <main class="container-auth">
        @RenderBody()
    </main>
}

<div id="toast-container"></div>
@if (!string.IsNullOrEmpty(toast))
{
    <div id="toast-data" data-toast="@toast" hidden></div>
}

<script src="~/js/toast.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>