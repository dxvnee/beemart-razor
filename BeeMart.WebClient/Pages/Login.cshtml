@page
@using System.Security.Permissions
@model Login
@{
    ViewData["Title"] = "Login";
}

<section class="card auth-card">
    <h1>Login</h1>
    <form method="post">
        <div class="field">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" required autocomplete="username" />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" required autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Login</button>
    </form>
    <p class="hint">Belum punya akun? <a asp-page="/Register">Register</a></p>
</section>
