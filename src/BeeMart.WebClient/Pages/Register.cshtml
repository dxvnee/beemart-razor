@page
@model Register
@{
    ViewData["Title"] = "Register Akun";
}
<section class="auth-card">
    <h1>Register Akun</h1>
    <form method="post">
        <div class="field">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" required maxlength="50" autocomplete="username" />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="FullName">Full Name</label>
            <input asp-for="FullName" required maxlength="100" />
            <span asp-validation-for="FullName" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" required maxlength="100" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">Re-Password</label>
            <input asp-for="ConfirmPassword" type="password" required autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Role">Role</label>
            <select asp-for="Role" required>
                <option value="Cashier">Kasir</option>
                <option value="Admin">Admin</option>
            </select>
            <span asp-validation-for="Role" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Daftar</button>
    </form>
    <p class="hint">Sudah punya akun? <a asp-page="/Login">Login</a></p>
</section>

@section Scripts {
    <script>
        const pw = document.getElementById('Password');
        const confirmPw = document.getElementById('ConfirmPassword');
        function checkMatch() {
            confirmPw.setCustomValidity(confirmPw.value === pw.value ? '' : 'Konfirmasi password tidak sama.');
        }
        pw.addEventListener('input', checkMatch);
        confirmPw.addEventListener('input', checkMatch);
    </script>
}