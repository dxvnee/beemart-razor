@page
@model NewTransaction
@{
    ViewData["Title"] = "New Transaction";
}
@Html.AntiForgeryToken()

<div class="invoice-bar">
    Invoice No: <span id="invoice">Memuat...</span>
</div>

<p class="search-hint">Cari Barang (Ketik: Apel / Susu, lalu tekan Enter)</p>
<div class="field">
    <input id="search" type="search" placeholder="Ketik nama barang..." autocomplete="off" />
</div>

<div id="search-results-section" style="display:none;">
    <table class="table">
        <thead>
            <tr>
                <th>Nama Barang</th>
                <th>Berat</th>
                <th>Stock</th>
                <th>Harga</th>
                <th>Diskon</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody id="search-results"></tbody>
    </table>

    <div id="selected-product-box" class="selected-product-box" style="display:none;">
        <div class="selected-title">Barang Terpilih: <span id="sel-name"></span></div>
        <div class="selected-row">
            <div class="selected-col">
                <span class="selected-label">Harga Satuan:</span>
                <span id="sel-price" class="selected-value"></span>
            </div>
            <div class="selected-col">
                <span class="selected-label">Sisa Stock:</span>
                <span id="sel-stock" class="selected-value"></span>
            </div>
            <div class="selected-col qty-col">
                <label for="sel-qty">Qty:</label>
                <input type="number" id="sel-qty" value="1" min="1" class="qty-field" />
            </div>
            <button type="button" id="btn-add-cart" class="btn btn-primary">Masukkan ke Keranjang</button>
        </div>
    </div>
</div>

<h2 style="margin-top: 20px;">Daftar Belanjaan</h2>
<table class="table">
    <thead>
        <tr>
            <th>Nama Barang</th>
            <th>Harga</th>
            <th>Diskon</th>
            <th>Qty</th>
            <th>Subtotal</th>
            <th>Aksi</th>
        </tr>
    </thead>
    <tbody id="cart-body"></tbody>
</table>

<div class="total-row">
    Total: <span id="total" style="margin-left: 8px;">Rp 0</span>
</div>

<div class="payment-row">
    <label for="payment">Metode Pembayaran:</label>
    <select id="payment" required>
        <option value="">-- Memuat metode... --</option>
    </select>
</div>

<button id="btn-save" type="button" class="btn btn-primary btn-block">Submit Transaksi</button>

@section Scripts {
    <script src="~/js/new-transaction.js" asp-append-version="true"></script>
}